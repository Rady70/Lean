<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MarketLab-owned session-map generator: derives the source-session map for the SingleAnchor
    historical replay from the immutable Dukascopy JForex XAUUSD monthly CSV history, using the
    same session-junction rule and session types as the strategy assembly. See
    MarketLab\SINGLE_ANCHOR_VNEXT_IMPLEMENTATION.md section 8 for the exact build and run
    commands. The generated map is a research artifact and belongs outside Git.
    Upstream LEAN is unchanged.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarketLab.SessionMapTool</RootNamespace>
    <AssemblyName>MarketLab.SessionMapTool</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SingleAnchor\MarketLab.SingleAnchor.csproj" />
  </ItemGroup>
</Project>
